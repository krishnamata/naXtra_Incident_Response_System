from sqlalchemy.orm import joinedload
from flask import request, render_template, session, redirect, url_for, jsonify, Blueprint
from sqlalchemy import asc, desc, cast, Integer, func
from markupsafe import Markup
from app.models import Alert, User
from app.extensions import db
from app.rules.rules_loader import load_rules, parse_rule_description
from app.playbooks.dispatcher import dispatch_playbook, assign_playbook_to_alert
from app.utils.mitre import get_mitre_info
from app.dlp import detect_logs_and_generate_alerts
from app.integrations.ioc_enrichment import enrich_ioc
import logging

logger = logging.getLogger(__name__)

alerts_bp = Blueprint('alerts', __name__,template_folder='templates', url_prefix='/alerts')


@alerts_bp.route('/api/new_alerts_count')
def new_alerts_count_api():
    count = Alert.query.filter_by(is_new=True).count()
    return jsonify({'new_alert_count': count})


@alerts_bp.route('/notifications')
def alert_notifications():
    if 'user_id' not in session:
        return redirect(url_for('auth.login'))

    new_alerts = Alert.query.filter_by(is_new=True).order_by(Alert.detected_time.desc()).all()
    return render_template('alerts_notifications.html', alerts=new_alerts)

@alerts_bp.route("/assign/<int:alert_id>", methods=["POST"])
def assign_alert(alert_id):
    user_id = request.form.get("user_id")
    alert = Alert.query.get_or_404(alert_id)
    if user_id:
        alert.assigned_to_id = user_id
        db.session.commit()
    return redirect(url_for("alerts.view_alerts"))







@alerts_bp.route('/')
def view_alerts():
    agent_name = request.args.get('agent_name', None)
    page = request.args.get('page', 1, type=int)
    sort_by = request.args.get('sort_by', 'severity')
    sort_order = request.args.get('sort_order', 'desc')
    min_level = request.args.get('min_level', 0, type=int)
    max_level = request.args.get('max_level', 15, type=int)

    # Generate alerts from logs
    detect_logs_and_generate_alerts()
    show_malware = request.args.get("malware", "false").lower() == "true"
    query = db.session.query(Alert).options(joinedload(Alert.playbook))

    # Filter by malware or normal alerts
    if show_malware:
        query = query.filter(Alert.is_malware == True)
    else:
        query = query.filter(Alert.is_malware == False)

    # Filter by agent
    if agent_name:
        query = query.filter(func.lower(Alert.agent_name) == agent_name.lower())

    # Filter by severity range
    query = query.filter(cast(Alert.severity, Integer) >= min_level,
                         cast(Alert.severity, Integer) <= max_level)

    # Optional: show only alerts assigned to logged-in user if not admin
    if 'user_id' in session and session.get('role') != 'admin':
        query = query.filter(Alert.assigned_to_id == session['user_id'])

    # Sorting
    order_column = Alert.detected_time if sort_by == 'time' else cast(Alert.severity, Integer)
    if sort_order == 'asc':
        query = query.order_by(asc(order_column), Alert.detected_time.desc())
    else:
        query = query.order_by(desc(order_column), Alert.detected_time.desc())

    pagination = query.paginate(page=page, per_page=20, error_out=False)
    alerts_page = pagination.items

    # Load rules for MITRE mapping
    rules = load_rules("app/rules/wazuh-ruleset/rules/")
    rules_dict = {rule['id']: rule for rule in rules if 'id' in rule}

    enriched_alerts = []
    for alert in alerts_page:
        rule_data = rules_dict.get(alert.rule_id)
        description = alert.description or f"Alert from rule ID: {alert.rule_id or 'Unknown'} — no valid tags found."
        mitre_id = None

        if rule_data:
            description, _, rule_id = parse_rule_description(rule_data['element'], alert.severity)
            mitre_id = rule_data.get('technique_id')
            if mitre_id and mitre_id != "NA":
                mitre_url = f"https://attack.mitre.org/techniques/{mitre_id}/"
                description = description.replace(mitre_id, f'<a href="{mitre_url}" target="_blank">{mitre_id}</a>')

        description = Markup(description)

        # Playbook assignment
        if not getattr(alert, "playbook_steps", None):
            assign_playbook_to_alert(alert)
            playbook_steps = dispatch_playbook(alert) or []
        else:
            playbook_steps = alert.playbook_steps

        technique_id = mitre_id if mitre_id and mitre_id != "NA" else None
        technique_link = f"https://attack.mitre.org/techniques/{technique_id}/" if technique_id else None

        # IOC enrichment
        ioc_enrichment = {}
        if alert.is_malware and (alert.sha256_hash or alert.md5_hash):
            ioc_enrichment = enrich_ioc(md5_hash=alert.md5_hash, sha256_hash=alert.sha256_hash)
        if alert.is_malware and not ioc_enrichment:
            logger.warning(f"No IOC enrichment found (Probable Safe from malware) for alert ID {alert.id}")

        

        alert_data = {
            "id": alert.id,
            "detected_time": alert.detected_time,
            "description": description,
            "level": alert.severity,
            "technique_id": technique_id,
            "technique_link": technique_link,
            "agent_name": alert.agent_name,
            "playbook": alert.playbook,
            "playbook_steps": playbook_steps,
            "rule_id": alert.rule_id,
            "ioc_enrichment": ioc_enrichment,
            "assigned_to": alert.assigned_to_user.username if getattr(alert, 'assigned_to_user', None) else "-",
            "status": alert.status if hasattr(alert, 'status') else "Pending",
            "confirm_assign": True if not getattr(alert, 'assigned_to_user', None) else False,
        }

        if technique_id:
            mitre_info = get_mitre_info(technique_id)
            if mitre_info:
                alert_data["mitre"] = mitre_info

        enriched_alerts.append(alert_data)

    agent_names = [name[0] for name in db.session.query(Alert.agent_name).distinct().all() if name[0] is not None]
    assignable_users = User.query.filter(User.role != 'admin').all()


    return render_template(
        'alerts.html',
        alerts=enriched_alerts,
        selected_agent=agent_name,
        min_level=min_level,
        max_level=max_level,
        pagination=pagination,
        agent_names=agent_names,
        assignable_users=assignable_users,
        show_malware=show_malware,
    )




@alerts_bp.route("/dlp-run")
def run_dlp_manually():
    print("[DEBUG] /dlp-run route accessed")
    run_dlp()
    return "DLP triggered manually"
