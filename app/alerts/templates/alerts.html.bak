{% extends 'base.html' %}

{% block title %}Alerts - naXtraSOAR{% endblock %}

{% block content %}
<div class="container mt-4">
  {% if selected_agent %}
  <div class="alert alert-info">
    Showing alerts triggered by rules for agent: <strong>{{ selected_agent }}</strong>
  </div>
  {% endif %}

  <form method="get" action="{{ url_for('alerts.view_alerts') }}" class="mb-3">
    <label for="agent_name">Filter by Agent:</label>
    <select name="agent_name" id="agent_name" onchange="this.form.submit()">
      <option value="">-- All Agents --</option>
      {% for agent in agent_names %}
      <option value="{{ agent }}" {% if agent == selected_agent %}selected{% endif %}>{{ agent }}</option>
      {% endfor %}
    </select>

    <label for="min_level" class="ms-3">Min Level:</label>
    <input type="number" name="min_level" id="min_level" min="0" max="15" value="{{ min_level or '' }}" onchange="this.form.submit()">

    <label for="max_level" class="ms-3">Max Level:</label>
    <input type="number" name="max_level" id="max_level" min="0" max="15" value="{{ max_level or '' }}" onchange="this.form.submit()">
  </form>

  <form method="get" action="{{ url_for('alerts.view_alerts') }}" id="sortForm" class="mb-3">
    <label for="sort_by">Sort by:</label>
    <select name="sort_by" id="sort_by" onchange="this.form.submit()">
      <option value="severity" {% if request.args.get('sort_by', 'severity') == 'severity' %}selected{% endif %}>Severity</option>
      <option value="time" {% if request.args.get('sort_by') == 'time' %}selected{% endif %}>Time</option>
    </select>

    <label for="sort_order" class="ms-3">Order:</label>
    <select name="sort_order" id="sort_order" onchange="this.form.submit()">
      <option value="desc" {% if request.args.get('sort_order', 'desc') == 'desc' %}selected{% endif %}>Descending</option>
      <option value="asc" {% if request.args.get('sort_order') == 'asc' %}selected{% endif %}>Ascending</option>
    </select>

    <!-- Preserve other filters -->
    <input type="hidden" name="agent_name" value="{{ selected_agent or '' }}">
    <input type="hidden" name="min_level" value="{{ min_level or '' }}">
    <input type="hidden" name="max_level" value="{{ max_level or '' }}">
    <input type="hidden" name="page" value="{{ pagination.page if pagination else 1 }}">
      </form>

  <table id="alertsTable" class="table table-bordered table-hover">
    <thead class="table-dark">
      <tr>
        <th>Detected Time</th>
        <th>Level</th>
        <th>Description</th>
        <th class="col-3">Playbook</th>
        <th>Rule ID</th>
        <th>More info</th>
        <th>Mitre ID</th>
        <th>IOC Info</th>
        <th>Assigned To</th>
        <th>Confirm Assign</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      {% for alert in alerts %}
      <tr>
        <td>{{ alert.detected_time }}</td>
        <td>{{ alert.level }}</td>
        <td title="{{ alert.description|striptags }}">{{ alert.description | safe }}</td>
        <td>
          {% if alert.playbook_steps %}
          <div class="accordion" id="accordion-{{ alert.id }}">
            <div class="accordion-item">
              <h2 class="accordion-header" id="heading-{{ alert.id }}">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-{{ alert.id }}" aria-expanded="false" aria-controls="collapse-{{ alert.id }}">
                  View Steps
                </button>
              </h2>
              <div id="collapse-{{ alert.id }}" class="accordion-collapse collapse" aria-labelledby="heading-{{ alert.id }}" data-bs-parent="#accordion-{{ alert.id }}">
                <div class="accordion-body p-2">
                  <ul class="list-group">
                    {% for step in alert.playbook_steps %}
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                      {{ step }}
                      {% if session.get('role') == 'admin' %}
                        <button class="btn btn-sm btn-outline-primary" onclick="executeStep('{{ step }}', '{{ alert.agent_ip }}')">Execute</button>
                      {% else %}
                        <span class="text-muted">Admin only</span>
                      {% endif %}
                    </li>
                    {% endfor %}
                  </ul>
                </div>
              </div>
            </div>
          </div>
          {% else %}
          <span class="text-muted">No playbook steps</span>
          {% endif %}
        </td>
 <td>
{% if alert.rule_id %}
    <a href="{{ url_for('search.search_view') }}?search_query={{ alert.rule_id }}">
      {{ alert.rule_id }}
    </a>
  {% else %}
    <span class="text-muted">-</span>
  {% endif %}

</td>

        <td>
         {% if alert.mitre %}
  <div>
    <strong>{{ alert.mitre.name }}</strong><br>
    <small>{{ alert.mitre.tactic }}</small>
  </div>
{% else %}
  <span class="text-muted">-</span>
{% endif %}

        </td>
<td>
  {% if alert.technique_id and alert.technique_id != 'NA' %}
    <a href="https://attack.mitre.org/techniques/{{ alert.technique_id }}/" target="_blank">
      {{ alert.technique_id }}
    </a>
  {% else %}
    <span class="text-muted">-</span>
  {% endif %}
</td>
<td>
  {% if alert.enrichment_data %}
    <div class="accordion" id="ioc-accordion-{{ alert.id }}">
      <div class="accordion-item">
        <h2 class="accordion-header" id="ioc-heading-{{ alert.id }}">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#ioc-collapse-{{ alert.id }}" aria-expanded="false" aria-controls="ioc-collapse-{{ alert.id }}">
            View IOC Details
          </button>
        </h2>
        <div id="ioc-collapse-{{ alert.id }}" class="accordion-collapse collapse" aria-labelledby="ioc-heading-{{ alert.id }}">
          <div class="accordion-body p-2">
            {% if alert.enrichment_data.get('hybrid_analysis') %}
              <strong>Hybrid Analysis:</strong>
              <pre class="small">{{ alert.enrichment_data.get('hybrid_analysis') | tojson(indent=2) }}</pre>
            {% endif %}
            {% if alert.enrichment_data.get('threatfox') %}
              <strong>ThreatFox:</strong>
              <pre class="small">{{ alert.enrichment_data.get('threatfox') | tojson(indent=2) }}</pre>
            {% endif %}
            {% if alert.enrichment_data.get('malwarebazaar') %}
              <strong>MalwareBazaar:</strong>
              <pre class="small">{{ alert.enrichment_data.get('malwarebazaar') | tojson(indent=2) }}</pre>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  {% else %}
    <span class="text-muted">No IOC enrichment data</span>
  {% endif %}
</td>

<td>
  {% if session.get('role') == 'admin' %}
    {% if alert.assigned_to != "-" %}
      <span class="assigned-user">{{ alert.assigned_to }}</span>
    {% else %}
      <form class="assign-form" data-alert-id="{{ alert.id }}">
        <select name="user_id" class="form-select form-select-sm">
          <option value="">-- Assign to --</option>
          {% for user in assignable_users %}
            <option value="{{ user.id }}">{{ user.username }} ({{ user.role }})</option>
          {% endfor %}
        </select>
      </form>
    {% endif %}
  {% else %}
    {{ alert.assigned_to if alert.assigned_to != "-" else "Unassigned" }}
  {% endif %}
</td>


 <td>
      {% if alert.confirm_assign %}
        <button class="btn btn-sm btn-outline-success">Confirm Assign</button>
      {% else %}
        <span class="text-muted">-</span>
      {% endif %}
    </td>
<td>{{ alert.status }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  {% if pagination %}
  <nav aria-label="Page navigation">
    <ul class="pagination">
      {% if pagination.has_prev %}
      <li class="page-item">
        <a class="page-link" href="{{ url_for('alerts.view_alerts', agent_name=selected_agent, page=pagination.prev_num, min_level=min_level, max_level=max_level, sort_by=request.args.get('sort_by', 'severity'), sort_order=request.args.get('sort_order', 'desc')) }}">Previous</a>
      </li>
      {% endif %}
      {% for page_num in pagination.iter_pages() %}
        {% if page_num %}
          <li class="page-item {% if page_num == pagination.page %}active{% endif %}">
            <a class="page-link" href="{{ url_for('alerts.view_alerts', agent_name=selected_agent, page=page_num, min_level=min_level, max_level=max_level, sort_by=request.args.get('sort_by', 'severity'), sort_order=request.args.get('sort_order', 'desc')) }}">{{ page_num }}</a>
          </li>
        {% else %}
          <li class="page-item disabled"><span class="page-link">…</span></li>
        {% endif %}
      {% endfor %}
      {% if pagination.has_next %}
      <li class="page-item">
        <a class="page-link" href="{{ url_for('alerts.view_alerts', agent_name=selected_agent, page=pagination.next_num, min_level=min_level, max_level=max_level, sort_by=request.args.get('sort_by', 'severity'), sort_order=request.args.get('sort_order', 'desc')) }}">Next</a>
      </li>
      {% endif %}
    </ul>
  </nav>
  {% endif %}
</div>

<!-- DataTables & Bootstrap JS -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  $(document).ready(function () {
    $('#alertsTable').DataTable({
      paging: false,
      ordering: true,
      order: [[0, 'desc']]
    });
  });

function executeStep(step, target_ip) {
  fetch('/playbook/execute_step', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/x-www-form-urlencoded',
      // Optionally add JWT token if you use Authorization headers
      // 'Authorization': 'Bearer ' + localStorage.getItem('jwt_token')
    },
    body: `step=${encodeURIComponent(step)}&target=${encodeURIComponent(target_ip)}`
  })
  .then(res => res.json())
  .then(data => {
    alert(`Status: ${data.status}\nMessage: ${data.message}`);
  })
  .catch(err => {
    alert('Error during execution');
  });
}
$(document).ready(function () {
  $('.assign-form select').on('change', function () {
    let form = $(this).closest('form');
    let alertId = form.data('alert-id');
    let userId = $(this).val();

    if (!userId) return;

    $.post(`/alerts/assign/${alertId}`, { user_id: userId })
      .done(() => {
        // Replace dropdown with assigned username text
        let username = $(this).find("option:selected").text();
        form.replaceWith(`<span class="text-success">${username}</span>`);
      })
      .fail(() => {
        alert("❌ Failed to assign user");
      });
  });
});

</script>
{% endblock %}
